# Bloc à AJOUTER au Caddyfile du serveur (le Caddy existant n'est pas géré par ce dépôt).
# Version de démonstration PUBLIQUE, sans mot de passe d'accès (décision du propriétaire,
# 2026-11-22) : n'importe qui peut agir en chef, donc aucune donnée réelle n'y est saisie.
# Pour protéger le site, ajouter dans ce bloc un `basic_auth` avec l'empreinte obtenue par
# `docker exec -it <conteneur-caddy> caddy hash-password`, sans jamais la commiter.
#
# Le contenu du bloc est celui de `protections.caddy` (que la copie locale importe). Il est
# recopié ici parce que le Caddy du serveur n'a pas accès au dépôt ; un test échoue si les
# deux divergent. Modifier d'abord `protections.caddy`.
chantier-ultra.ddns.net {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# Politique de contenu stricte : tout vient du site lui-même (polices auto-hébergées).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
		# Ni le proxy ni les serveurs derrière lui ne doivent annoncer leur logiciel.
		-Server
		-Via
	}

	# Fausses adresses que seuls les robots demandent. Elles vont à l'API (et non au site, qui
	# répondrait par sa page d'accueil) : elle répond 404 et bloque l'adresse en écriture.
	# Cette liste doit rester celle de `app/shared/api/pieges.py` (le même test le vérifie).
	# Le matcher `path` de Caddy compare sans tenir compte de la casse (documentation de Caddy,
	# « Path matches are exact but case-insensitive ») : `/WP-ADMIN` est donc pris comme `/wp-admin`.
	@pieges path /wp-admin /wp-admin/* /wp-login.php /wp-login.php/* /.env /.env/* /.git /.git/* /phpmyadmin /phpmyadmin/* /xmlrpc.php /xmlrpc.php/*
	handle @pieges {
		reverse_proxy chantier-api:8000 {
			# Adresse réelle du visiteur, imposée ici : la limite de débit et le blocage de
			# l'API comptent par adresse. Sans cette ligne, la valeur dépendrait de la
			# configuration globale du Caddy (`trusted_proxies`) et un visiteur pourrait
			# changer d'adresse à chaque requête (ADR 0016).
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle /api/* {
		# La documentation de l'API n'est pas exposée en production : le client TypeScript
		# est généré au build, et la page Swagger chargerait des scripts externes.
		@documentation path /api/docs* /api/openapi.json /api/redoc*
		respond @documentation 404

		# Les requêtes de l'API sont de petits JSON : on refuse tout corps plus gros,
		# avant qu'il ne soit lu en mémoire par l'application. `KiB` compte 1024 octets (`KB`
		# en compte 1000) : c'est la limite exacte de l'API, `TAILLE_MAX_CORPS` (64 * 1024).
		request_body {
			max_size 64KiB
		}
		reverse_proxy chantier-api:8000 {
			# Adresse réelle du visiteur, imposée ici : la limite de débit et le blocage de
			# l'API comptent par adresse. Sans cette ligne, la valeur dépendrait de la
			# configuration globale du Caddy (`trusted_proxies`) et un visiteur pourrait
			# changer d'adresse à chaque requête (ADR 0016).
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle {
		reverse_proxy chantier-web:8080
	}

	# Erreurs produites par le proxy lui-même (corps trop gros, API injoignable…), qui sortiraient
	# sinon sans en-têtes de sécurité, avec `Server` et sans corps. Elles prennent la forme des
	# erreurs de l'application (RFC 9457, ADR 0008). Les erreurs de l'API ne passent pas ici :
	# `reverse_proxy` les relaie comme des réponses normales, avec leur corps d'origine.
	handle_errors {
		# Le `header` du site ne s'applique pas aux erreurs du proxy : il est répété ici, à
		# l'identique (un test vérifie que les deux blocs restent les mêmes).
		header {
			Strict-Transport-Security "max-age=31536000"
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy strict-origin-when-cross-origin
			# Politique de contenu stricte : tout vient du site lui-même (polices auto-hébergées).
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
			Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
			Cross-Origin-Opener-Policy same-origin
			# Ni le proxy ni les serveurs derrière lui ne doivent annoncer leur logiciel.
			-Server
			-Via
		}
		header Content-Type application/problem+json

		# Mêmes titre et message que l'API (`erreurs.py`) : un test vérifie que les textes restent
		# les mêmes. Les autres statuts reçoivent la réponse générique de l'API pour un statut
		# qu'elle ne nomme pas.
		@trop_volumineux expression `{err.status_code} == 413`
		handle @trop_volumineux {
			respond `{"type":"about:blank","title":"Requête trop volumineuse","status":413,"detail":"Le corps de la requête est trop volumineux."}` 413
		}
		handle {
			respond `{"type":"about:blank","title":"Erreur","status":{err.status_code},"detail":"La requête n'a pas pu être traitée."}` {err.status_code}
		}
	}
}
