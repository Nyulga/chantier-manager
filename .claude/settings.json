{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(just verifier)",
      "Bash(just verifier *)",
      "Bash(just test-back *)",
      "Bash(just test-front *)",
      "Bash(just e2e)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(gh pr create *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(/c/Windows/System32/OpenSSH/ssh.exe *)",
      "Bash(/c/Windows/System32/OpenSSH/scp.exe *)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(git push * main)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(~/.claude.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/backend/tools/garde_agents.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
